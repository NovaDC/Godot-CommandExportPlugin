; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Commands Export Plugin"
config/name_localized={
"en": "Command Export Plugin"
}
config/description="A export plugin using ToolEditorExportPlugin to provide the ability for full CLI shell commands to be run during export.
Requires the NovaTools plugin as a dependency."
config/version="v3.0.0.0"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/image="uid://cx3lf16es7jjj"
config/icon="uid://blvnkioh6gakk"

[autoload]

TreeWatcher="*uid://byto6ql37kfie"

[editor_plugins]

enabled=PackedStringArray("res://addons/commands_export_plugin/plugin.cfg", "res://addons/novatools/plugin.cfg")

[internationalization]

locale/locale_filter_mode=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
